#
#  CMake itself
#
{
   CMake Binary Leak
   Memcheck:Leak
   match-leak-kinds: reachable,possible
   fun:malloc
   obj:*/bin/cmake
   obj:*/bin/cmake
   ...
}
#
#  Coverage instrumentation
#
#  The nightly debug builds compile with code_coverage=1, so every translation
#  unit registers its counters with the LLVM coverage runtime from an
#  initialiser. The runtime keeps the registration for the process lifetime and
#  never frees it, so every block is still reachable. Anchored on the runtime's
#  own frames, so an allocation that merely passes through the loader still
#  surfaces.
#
{
   LLVM coverage instrumentation registration
   Memcheck:Leak
   match-leak-kinds: reachable
   fun:malloc
   fun:llvm_gcov_init
   fun:__llvm_gcov_init
   ...
}
#
#  glibc atexit handler registration
#
#  A translation unit with a namespace-scope object registers its destructor
#  with __cxa_atexit when it loads, and glibc allocates the handler node for the
#  lifetime of the process, so the nodes are still reachable rather than lost.
#
{
   glibc atexit handler registration
   Memcheck:Leak
   match-leak-kinds: reachable
   fun:calloc
   fun:__new_exitfn
   fun:__internal_atexit
   fun:__cxa_atexit
   ...
}
#
#  Catch2 reporter output stream
#
#  The test binary opens its XML report file once, and the stream keeps its
#  buffer and its FILE until the process exits, which is after the reporter has
#  flushed. Anchored on the reporter's own stream type, so a file the tests open
#  themselves still surfaces.
#
{
   Catch2 reporter file stream
   Memcheck:Leak
   match-leak-kinds: reachable
   ...
   fun:_ZN5Catch6Detail12_GLOBAL__N_110FileStreamC1E*
   ...
}
