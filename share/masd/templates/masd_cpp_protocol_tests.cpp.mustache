TEST_CASE("{{name}}'s reader and JSON Schema refuse the same members",
    "[codec][schema][protocol]") {
    using traits = {{codec_namespace}}::wire_traits<{{qualified}}>;
    const auto schema = {{codec_namespace}}::json_schema<{{qualified}}>();
    const auto text = traits::write_json({{codec_namespace}}::sample<{{qualified}}>(0));
    const auto added = {{codec_namespace}}::with_unknown_member(text);
    CHECK_THROWS_AS(traits::read_json(added), std::invalid_argument);
    CHECK({{codec_namespace}}::schema_violation(schema, added).has_value());
    for (const auto name : {{codec_namespace}}::required_members<{{qualified}}>()) {
        INFO(name);
        const auto removed = {{codec_namespace}}::without_member(text, name);
        CHECK_THROWS_AS(traits::read_json(removed), std::invalid_argument);
        CHECK({{codec_namespace}}::schema_violation(schema, removed).has_value());
    }
    for (const auto name : {{codec_namespace}}::absent_members<{{qualified}}>()) {
        INFO(name);
