{
  "version": 8,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base-configuration",
      "description": "Base class for common configuration options.",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/output/${presetName}",
      "toolchainFile": "${sourceDir}/vcpkg/scripts/buildsystems/vcpkg.cmake",
      "environment": {
        "VCPKG_MAX_CONCURRENCY": "2"
      },
      "cacheVariables": {
        "CMAKE_CXX_STANDARD": "23",
        "CMAKE_CXX_STANDARD_REQUIRED": true,
        "CMAKE_CXX_EXTENSIONS": false,
        "CMAKE_EXPORT_COMPILE_COMMANDS": true
      },
      "warnings": {
        "uninitialized": true,
        "dev": false,
        "deprecated": true
      }
    },
    {
      "name": "debug-build",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      },
      "description": "Setup CMake debug build."
    },
    {
      "name": "release-build",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      },
      "description": "Setup CMake release build."
    },
    {
      "name": "clang",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++"
      },
      "description": "Setup the Clang C++ compiler."
    },
    {
      "name": "ninja",
      "hidden": true,
      "generator": "Ninja",
      "description": "Build using the Ninja build tool."
    },
    {
      "name": "linux-clang-debug",
      "displayName": "Linux Clang Debug",
      "inherits": [
        "base-configuration",
        "clang",
        "debug-build",
        "ninja"
      ],
      "description": "compass debug build for Linux Clang using Ninja."
    },
    {
      "name": "linux-clang-release",
      "displayName": "Linux Clang Release",
      "inherits": [
        "base-configuration",
        "clang",
        "release-build",
        "ninja"
      ],
      "description": "compass release build for Linux Clang using Ninja."
    }
  ],
  "buildPresets": [
    {
      "name": "linux-clang-debug",
      "configurePreset": "linux-clang-debug",
      "jobs": 2
    },
    {
      "name": "linux-clang-release",
      "configurePreset": "linux-clang-release",
      "jobs": 2
    }
  ],
  "testPresets": [
    {
      "name": "test-default",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": false
      }
    },
    {
      "name": "linux-clang-debug",
      "configurePreset": "linux-clang-debug",
      "inherits": [
        "test-default"
      ]
    },
    {
      "name": "linux-clang-release",
      "configurePreset": "linux-clang-release",
      "inherits": [
        "test-default"
      ]
    }
  ]
}
